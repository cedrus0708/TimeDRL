{
  "run": {
    "output_root": "./ood_runs",
    "run_name": "exchange_injected_knn_q095",
    "train_model": false
  },
  "cache": {
    "enabled": true,
    "cache_root": "./ood_runs/_cache",
    "materialize_mode": "copy",
    "hash_file_contents": true,
    "force_rebuild": false
  },
  "embedding_bank": {
    "model_for": "Exchange",
    "batch_size": 256,
    "model_registry_path": "./weights/args.json",
    "checkpoint_path": null,
    "mode": "pretrain",
    "embedding_view": "first",
    "l2_normalize": false
  },
  "forecasting_csv_injection": {
    "use_injection": true,
    "input_csv_path": "./dataset/forecasting/exchange_rate/exchange_rate.csv",
    "anomaly_fraction": 0.05,
    "anomaly_types": ["spike", "level_shift", "noise", "trend", "flatline"],
    "min_len": 8,
    "max_len": 32,
    "magnitude": 3.0,
    "channel_mode": "random_one",
    "inject_start_ratio": 0.7,
    "inject_end_ratio": 1.0,
    "seed": 42,
    "source_csv_path": null
  },
  "forecasting_labels": {
    "seq_len": 168,
    "patch_len": 16,
    "stride": 16,
    "window_start_index_key": "window_start_index"
  },
  "embedding_detector": {
    "k": 5,
    "metric": "euclidean",
    "score_mode": "mean",
    "normalization": "standardize",
    "threshold_quantile": 0.95,
    "batch_size": 1024,
    "max_timestamp_reference_vectors": 50000,
    "random_seed": 2023
  },
  "evaluate_detector": {
    "top_k": 100
  },
  "visualize_scores": {
    "enabled": true,
    "top_k": 100,
    "sample_id": 42
  },
  "experiment_dashboard": {
    "enabled": true
  },
  "forecasting_timeseries_browser": {
    "enabled": true,
    "top_k": 100,
    "top_csv_level": "instance"
  }
}
